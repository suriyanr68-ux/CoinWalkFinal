<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E293B">

    <!-- LAYER 1: ตัวเกม Custom View -->
    <com.example.coinwalk2.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- LAYER 2: UI Overlay แบบใหม่ -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- ================= TOP BAR ================= -->
        <LinearLayout
            android:id="@+id/containerScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
            android:background="@drawable/bg_metal_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💎🪙"
                android:textSize="18sp"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:background="#111111"
                android:gravity="center"
                android:text="0"
                android:textColor="#FF3333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />
        </LinearLayout>

        <!-- ตรงนี้แหละครับที่มี @+id/containerLevel ที่ระบบกำลังหาอยู่ -->
        <LinearLayout
            android:id="@+id/containerLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:background="@drawable/bg_metal_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⋙"
                android:textColor="#888888"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginRight="8dp"/>

            <TextView
                android:id="@+id/tvLevel"
                android:layout_width="50dp"
                android:layout_height="35dp"
                android:background="#111111"
                android:gravity="center"
                android:text="1"
                android:textColor="#FF3333"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="8" />
        </LinearLayout>

        <!-- ================= BOTTOM BAR ================= -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/btnBack"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.4">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SWIPE TO MOVE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="↑ JUMP | ↓ DUCK"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnBack"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_stop_button_metallic"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚫"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STOP"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </RelativeLayout>
</FrameLayout>